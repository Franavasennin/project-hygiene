  },
  "dependencies": {
    "ajv": "^8.17.1",
    "picomatch": "^4.0.2",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/picomatch": "^3.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
