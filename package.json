{
  "name": "project-hygiene",
  "version": "0.1.0",
  "description": "Audits and organizes software projects and AI-assisted development environments.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "hygiene": "./dist/cli/index.js" },
  "engines": { "node": ">=20" },
  "files": ["dist", "rules"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
